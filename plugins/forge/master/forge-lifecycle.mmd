%% Forge: where it lives and how it stays current. Paste into OS Flow: Import, Mermaid tab, new Agent flow.
%% Prefixes set the block kind on import (knowledge:, tool:, human:, skeptic:, output:).
flowchart LR
  knowledge:master[("Forge master · Claude OS repo · 00_Resources/forge: renderer forge.html, contract forge.schema.json, tool forge.mjs, the /forge skill")]
  tool:update[["forge.mjs update · copies renderer, contract and tool into a project repo's forge/ folder; copies are never edited there"]]
  knowledge:osflow[("OS Flow repo · forge/forge.json · the one source of OS Flow's status")]
  knowledge:ta[("Training App repo · forge/forge.json · the one source of Course Forge's status")]
  knowledge:pf[("Geniotek Platform repo · forge/forge.json · the one source of the Platform's status")]
  human:session("The project's cloud session · edits forge.json the turn something moves · runs /forge")
  knowledge:memory[("MEMORY.md § Decisions · the log; the board mirrors it with a memory_ref")]
  tool:build[["forge.mjs touch · roadmap · build · stamps the time, regenerates ROADMAP.md's status block, inlines the JSON into forge/board.html"]]
  skeptic:check{{"forge.mjs check · fails on a schema error, ROADMAP drift, a decision missing from MEMORY.md, a banned pattern, an ask closed by an agent · runs in the repo's gate"}}
  output:board(("forge/board.html · published to the project's fixed artifact address · what Jase reads today"))
  output:page(("OS Flow app · Forge page per project · after M3b · reads the same JSON from a store the session fills with one PUT · the team reads it behind the login"))
  human:jase("Jase · reads the board, answers asks in chat · an ask with a firing default fires on its date unless he vetoes")

  knowledge:master -->|copies| tool:update
  tool:update --> knowledge:osflow
  tool:update --> knowledge:ta
  tool:update --> knowledge:pf
  knowledge:memory -.->|memory_ref handoff| human:session
  human:session -.->|edits handoff| knowledge:osflow
  human:session -.->|edits handoff| knowledge:ta
  human:session -.->|edits handoff| knowledge:pf
  knowledge:osflow --> tool:build
  knowledge:ta --> tool:build
  knowledge:pf --> tool:build
  tool:build --> skeptic:check
  skeptic:check ==>|pass| output:board
  skeptic:check ==>|fail: fix and rerun| human:session
  output:board --> human:jase
  knowledge:osflow -.->|PUT, after M3b| output:page
  knowledge:ta -.->|PUT, after M3b| output:page
  knowledge:pf -.->|PUT, after M3b| output:page
  output:page --> human:jase
  human:jase -.->|decision logged in chat| knowledge:memory
